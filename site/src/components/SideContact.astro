---
/**
 * Side contact rail — fixed to the right edge (desktop only).
 * Email · WeChat. Contact runs through these two channels only:
 * no phone, no WhatsApp, and no request form anywhere on the site.
 * The email tile reveals its address on hover; WeChat reveals its QR.
 */
import { existsSync } from 'node:fs';
import type { Locale } from '../i18n/dict';
import { asset } from '../lib/paths';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEN = locale === 'en';

const email = 'sales@example.hk';
const wechatLabel = isEN ? 'Scan to add on WeChat' : '扫码添加微信';

/* The QR is a real asset the client supplies. Until the file lands, the panel
   keeps a labelled placeholder rather than a broken image. */
const QR_FILE = 'wechat-qr.png';
const hasQR = existsSync(new URL(`../../public/images/${QR_FILE}`, import.meta.url));
const qrSrc = asset(`/images/${QR_FILE}`);
---

<aside class="side-contact" aria-label={isEN ? 'Contact' : '联系方式'} data-side-contact>
  <a class="sc-item" href={`mailto:${email}`} aria-label={`${isEN ? 'Email' : '邮件'} ${email}`}>
    <span class="sc-ico" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>'} />
    <span class="sc-pop">{email}</span>
  </a>

  <button type="button" class="sc-item sc-wechat" aria-label="WeChat" aria-expanded="false" data-wechat>
    <span class="sc-ico" set:html={'<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8.69 4C4.98 4 2 6.46 2 9.5c0 1.73.97 3.27 2.49 4.29L4 16l2.2-1.1c.45.12.92.2 1.4.24-.06-.3-.1-.6-.1-.91 0-2.86 2.7-5.13 6-5.13.22 0 .43.01.64.03C13.7 6.06 11.42 4 8.69 4zm-2.2 3.2a.86.86 0 1 1 0 1.72.86.86 0 0 1 0-1.72zm4.4 0a.86.86 0 1 1 0 1.72.86.86 0 0 1 0-1.72z"/><path d="M22 14.23c0-2.5-2.46-4.53-5.5-4.53s-5.5 2.03-5.5 4.53 2.46 4.53 5.5 4.53c.6 0 1.18-.08 1.72-.23L20 19.7l-.46-1.5C21.06 17.34 22 15.88 22 14.23zm-7.3-1.1a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4zm3.6 0a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4z"/></svg>'} />
    <div class="sc-pop sc-pop--qr">
      <span class="sc-qr-title">{wechatLabel}</span>
      {hasQR
        ? <img class="sc-qr-img" src={qrSrc} alt={isEN ? 'WeChat QR code' : '微信二维码'} width="118" height="118" loading="lazy" />
        : <span class="sc-qr" aria-hidden="true">QR</span>}
    </div>
  </button>
</aside>

<script>
  /* The QR panel opens on hover for a pointer and on click for everyone else;
     aria-expanded keeps the state announced either way. */
  const wechat = document.querySelector('[data-wechat]');
  if (wechat) {
    const set = (open) => {
      wechat.classList.toggle('is-open', open);
      wechat.setAttribute('aria-expanded', String(open));
    };
    wechat.addEventListener('click', () => set(wechat.getAttribute('aria-expanded') !== 'true'));
    wechat.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    wechat.addEventListener('blur', () => set(false));
  }

  const rail = document.querySelector('[data-side-contact]');
  const hero = document.querySelector('.hero');
  if (rail && hero) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          rail.classList.toggle('is-visible', !entry.isIntersecting);
        }
      },
      { rootMargin: '-40% 0px 0px 0px' }
    );
    io.observe(hero);
  }
</script>
