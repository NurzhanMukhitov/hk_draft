---
/**
 * Cheng Trading Limited — the CTL mark.
 *
 * A bitmap in two colourways rather than one recolourable SVG: the artwork is
 * a raster export, so the navy original and a white version for the navy
 * footer are both generated by scripts/build-images.py and stay in step when
 * the mark is replaced.
 *
 * Size is set in CSS by context, never inline: an inline height beats any
 * stylesheet rule, which silently kills the responsive steps.
 *
 * The mark is the whole logo — it carries the name, so its alt text does too.
 */
import { readFileSync } from 'node:fs';
import { asset } from '../lib/paths';

interface Props {
  /** Which ground it sits on — picks the colourway. */
  on?: 'light' | 'dark';
  class?: string;
}
const { on = 'light', class: className } = Astro.props;
const src = asset(on === 'dark' ? '/images/logo-mark-on-navy.png' : '/images/logo-mark.png');

/* Read the real pixel size out of the PNG header at build time. Hard-coding it
   means the reserved box stops matching the art the moment the mark changes
   shape — and this one already went from square to a wide lockup. */
let intrinsic = { w: 320, h: 203 };
try {
  const png = readFileSync(new URL('../../public/images/logo-mark.png', import.meta.url));
  intrinsic = { w: png.readUInt32BE(16), h: png.readUInt32BE(20) };
} catch {
  /* build-images.py has not run yet; the fallback keeps the aspect sane */
}
---

<img
  src={src}
  alt="Cheng Trading Limited"
  width={intrinsic.w}
  height={intrinsic.h}
  class:list={['site-logo', className]}
/>
